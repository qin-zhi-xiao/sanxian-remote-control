.kt {
  display: flex;
  align-items: stretch;
  height: 72rpx;
  background: #0b0c0e;
  border-bottom: 1rpx solid #1d2027;
  overflow-x: auto;
  flex-shrink: 0;
}
.kt-tab {
  display: flex;
  align-items: center;
  padding: 0 18rpx;
  color: #8b9199;
  font-size: 24rpx;
  border-right: 1rpx solid #14171b;
  white-space: nowrap;
}
.kt-tab.on {
  color: #e8eaed;
  background: #121418;
  box-shadow: inset 0 -3rpx 0 #5fd08a;
}
.kt-t { margin-right: 8rpx; }
.kt-x {
  color: #5a6068;
  font-size: 26rpx;
  padding: 0 6rpx;
}
.kt-add {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  color: #6b7178;
  font-size: 30rpx;
}
