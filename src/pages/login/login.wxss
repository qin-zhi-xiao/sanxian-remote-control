page { height: 100%; background: #0b0c0e; }
.login {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 0 56rpx;
  box-sizing: border-box;
}
.login-brand {
  padding-top: 180rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.login-logo {
  width: 120rpx; height: 120rpx;
  border-radius: 32rpx;
  background: #1a1f26;
  border: 1rpx solid #2c3138;
  color: #e8eaed;
  font-size: 52rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.login-name { margin-top: 28rpx; font-size: 44rpx; color: #e8eaed; font-weight: 600; }
.login-sub { margin-top: 12rpx; font-size: 23rpx; color: #5a6068; }

.login-body { margin-top: 96rpx; }

.lg-btn {
  height: 92rpx;
  border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx;
  background: #151a21;
  border: 1rpx solid #232b36;
  color: #c6cad0;
}
.lg-primary { background: #e8eaed; color: #0b0c0e; border-color: #e8eaed; font-weight: 600; }

.login-tip {
  margin-top: 14rpx;
  font-size: 20rpx;
  color: #4d535a;
  text-align: center;
}

.lg-divider {
  display: flex; align-items: center;
  margin: 44rpx 0;
}
.lg-divider::before, .lg-divider::after {
  content: ''; flex: 1; height: 1rpx; background: #1d2027;
}
.lg-divider text { padding: 0 24rpx; font-size: 20rpx; color: #3f454c; }

.lg-input {
  height: 88rpx;
  margin-bottom: 20rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: #121418;
  border: 1rpx solid #23272e;
  border-radius: 14rpx;
  color: #e8eaed;
  font-size: 26rpx;
}
.lg-ph { color: #4d535a; }

.login-hint {
  margin-top: 32rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  background: #1a1315;
  border: 1rpx solid #3a2226;
  color: #e0846f;
  font-size: 22rpx;
  line-height: 1.6;
}
.lg-code-row { display: flex; align-items: center; gap: 16rpx; margin-top: 20rpx; }
.lg-code-btn {
  flex-shrink: 0;
  height: 88rpx;
  padding: 0 26rpx;
  display: flex; align-items: center; justify-content: center;
  background: #151a21; border: 1rpx solid #232b36; border-radius: 14rpx;
  color: #8fb4d9; font-size: 24rpx;
}
.lg-disabled { color: #4d535a; }
.lg-soon { margin-left: 12rpx; font-size: 18rpx; color: #5a6068; border: 1rpx solid #2c3138; border-radius: 4rpx; padding: 1rpx 8rpx; }
