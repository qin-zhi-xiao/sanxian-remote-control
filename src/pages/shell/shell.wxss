page { height: 100%; }
.screen { min-height: 100vh; background: #0b0c0e; }
.stack {
  display: flex; flex-direction: column; justify-content: center;
  min-height: 100vh; padding: 0 40rpx; box-sizing: border-box;
}
.title-lg { font-size: 44rpx; font-weight: 600; color: #e8eaed; }
.sub { font-size: 24rpx; color: #8b9199; }

.shell-list { margin-top: 48rpx; }

.shell-item {
  display: flex; align-items: center;
  padding: 28rpx 24rpx; margin-bottom: 18rpx;
  background: #121418; border: 1rpx solid #23272e; border-radius: 14rpx;
}
.shell-item:active { background: #171a1f; }
.shell-on { border-color: #e8eaed; background: #171a1f; }

/* 左侧图标方块 */
.shell-icon {
  width: 76rpx; height: 76rpx; border-radius: 12rpx;
  display: flex; align-items: center; justify-content: center;
  font-family: Consolas, "SF Mono", monospace; font-weight: 700;
  font-size: 26rpx; margin-right: 24rpx; flex-shrink: 0;
}
.gitbash-icon { background: #1f2b22; color: #23d18b; }
.cmd-icon { background: #10202e; color: #3b8eea; }
.ps-icon { background: #1a1f36; color: #7aa2f7; }

.shell-text { flex: 1; }
.shell-name { font-size: 30rpx; color: #e8eaed; font-weight: 600; }
.shell-desc { font-size: 22rpx; color: #7d848c; margin-top: 6rpx; }

.shell-check { color: #e8eaed; font-size: 32rpx; }
