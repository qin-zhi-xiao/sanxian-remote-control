page { height: 100%; }
.term { position: relative; height: 100vh; background: #0b0c0e; overflow: hidden; }
.out { height: 100%; padding: 16rpx 20rpx 0; box-sizing: border-box; }
.line {
  font-family: Consolas, "SF Mono", monospace; font-size: 24rpx; line-height: 1.45;
  color: #c6cad0; white-space: pre-wrap; word-break: break-all;
  display: block;
}
/* 颜色片段：纯内联，不加任何边框/背景，避免出现“框” */
.seg { white-space: pre-wrap; -webkit-user-select: none; user-select: none; }
.ghost {
  position: fixed; left: 0; top: 0; width: 100%; height: 100%;
  color: transparent; background: transparent; caret-color: transparent;
  opacity: 0.01; z-index: 99; border: none; padding: 0; line-height: normal;
}
